# Origem do frontend liberada no CORS
APP_ORIGIN=http://localhost:5173

# Segredo que assina os tokens JWT. OBRIGATÓRIO: o servidor não sobe sem ele.
# O valor abaixo é só para desenvolvimento. Em produção use um valor aleatório
# com 32+ caracteres (o servidor recusa segredo fraco quando NODE_ENV=production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super-secret

DATABASE_URL="postgresql://admin:admin@localhost:5433/adopet?schema=public"

# Opcionais
# PORT=3001
# NODE_ENV=development   # inclui a stack trace nas respostas de erro 500 (nunca use em produção)
